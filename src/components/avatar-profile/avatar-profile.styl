.avatar-profile
    width 130px
    height 130px
    border-radius 50%
    background url("data:image/png;base64,") 50% 50% no-repeat var(--form-ele-bg)
    background-size 40px 40px
    margin 0 auto 20px
    position relative
    cursor pointer
    &:hover
        .avatar-profile__change
            opacity 1
    &__img-wrap
        width 100%
        height 100%
        border-radius 50%
    &__img
        display block
        width 100%
        height 100%
        object-fit cover
        border-radius 50%
