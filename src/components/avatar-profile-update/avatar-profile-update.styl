.avatar-profile
    &__change
        display flex
        align-items center
        justify-content center
        width 100%
        height 100%
        padding 10px
        border-radius 50%
        background var(--avatar-hover-bg)
        position absolute
        top 0
        left 0
        font-size 1.3rem
        line-height 1.4rem
        text-align center
        color var(--btn-color)
        opacity 0
        transition all .175s
